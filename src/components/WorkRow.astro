---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'work'>;
}

const { entry } = Astro.props;
const { title, summary, date, tags } = entry.data;

const stamp = formatDate(date, 'compact');
---

<a
  href={`/work/${entry.id}`}
  class="group border-line hover:border-signal grid grid-cols-[3rem_minmax(0,1fr)_auto] items-center gap-4 border-b py-5 transition-colors sm:grid-cols-[4.5rem_minmax(0,1fr)_auto] sm:gap-6"
>
  <span class="text-ink-soft font-mono text-xs">{stamp}</span>

  <span class="min-w-0">
    <span
      class="font-display text-ink group-hover:text-signal block break-words text-lg transition-colors"
    >
      {title}
    </span>
    <span class="text-ink-soft mt-1 block text-sm">{summary}</span>
  </span>

  <span class="flex items-center gap-4">
    <span class="text-ink-soft hidden font-mono text-[11px] md:block">
      {tags.slice(0, 2).join(' · ')}
    </span>
    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
