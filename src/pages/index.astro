---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
const projects = [
 ['01 / PUBLIC RESEARCH','21-DoF robotic hand','Mechanical architecture, actuator packaging, simulation, and motor control for visual self-modeling experiments.','shadow-hand','Hardware design · URDF / PyBullet · Control'],
 ['02 / GRADUATION RESEARCH','Computational modular robotics','Searching robot configurations against task geometry and mechanical limits, then taking promising designs toward hardware.','modular-robotics','Configuration search · Load analysis · Coupling'],
 ['03 / MEDICAL ROBOTICS CAPSTONE','Acoustic sensing for intubation','An experimental platform for studying tube–tissue interaction, with a focus on alignment, stiffness, and vibration isolation.','intubation','Experimental design · Fixtures · Team leadership'],
 ['04 / INDUSTRY','Precision manufacturing equipment','Fixtures, printer commissioning, post-processing hardware, and troubleshooting at Trio Labs.','trio-labs','Mechanical design · Bring-up · Validation'],
];
---
<BaseLayout title={SITE.name}>
<div class="shell">
 <section class="hero">
  <div><span class="kicker">Robotics hardware / Selected work</span><h1>Designing robots.<br/>Building the hardware.<br/>Making it work.</h1>
  <p>{SITE.description}</p><div class="actions"><a class="primary" href="#work">Explore my work ↗</a><a href="/about">About me</a></div>
  <span class="kicker">Duke M.S. · Graduating December 2026</span></div>
  <figure><img src="/shadow.gif" alt="The Shadow robotic hand demonstrating projected shadow shapes" width="600" height="508"/><figcaption>FIG. 01 — SHADOW / 21-DoF HAND<br/>Project media: Duke General Robotics Lab</figcaption></figure>
 </section>
 <section id="work"><div class="work-heading"><h2 class="kicker">Selected engineering work</h2><span class="kicker">2025—2026</span></div>
 <div class="project-grid">{projects.map(([label,title,summary,slug,tags]) => <article class="project"><span class="kicker">{label}</span><h3><a href={`/work/${slug}`}>{title}</a></h3><p>{summary}</p><p style="font-size:11px">{tags}</p><a class="detail" href={`/work/${slug}`}>View project ↗</a></article>)}</div>
 </section>
 <aside class="band"><h2 class="kicker">Additional research</h2><p>I also contribute hardware and system integration to a confidential robotics automation project. Details and project media are withheld pending public release.</p></aside>
 <section id="contact" class="contact-section"><span class="kicker">Contact</span><h2>Robotics hardware & electromechanical systems.</h2><p class="text-ink-soft">Interested in mechanisms, prototyping, and getting physical systems to work.</p><div class="actions"><a href={`mailto:${SITE.email}`}>{SITE.email}</a><a href="https://www.linkedin.com/in/boyuan-ben-wang/">LinkedIn ↗</a></div></section>
</div>
</BaseLayout>
