---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
const projects = [
 {label:'01 / PUBLIC RESEARCH',title:'21-DoF robotic hand',summary:'Can a robot estimate the state of its own hand from images?',contribution:'I designed and built the 21-DoF hand from scratch, including its finger mechanisms, palm, actuator packaging, and TPU covers. I also developed its URDF/PyBullet model and motor-control/data-logging pipeline.',result:'Two major hardware revisions improved joint motion and fixed problems found in TPU cover testing. I also traced a motor-communication bottleneck and switched to batched commands.',slug:'shadow-hand',tags:'Hand Mechanisms · Actuator Packaging · Sim-to-Real',image:'/shadow.gif'},
 {label:'02 / GRADUATION RESEARCH',title:'Computational modular robotics',summary:'The same actuator modules can be reconfigured for different tasks using printed links.',contribution:'I designed the modules and magnetic couplers, then built a task-driven search that evaluates reachability, collisions, motor torque, payload, and coupler loads across roughly 80,000 simulated designs.',result:'The module shrank from roughly 110 mm per side and 500–600 g to about 68 × 68 × 72 mm and 290 g. Coupler tests revealed a bending limit relevant to CNC-loading configurations.',slug:'modular-robotics',tags:'Module Design · Coupler Testing · Configuration Search',image:'/projects/modular-robots/thumbnail.png',imageAlt:'Simulated modular robot configurations',gallery:'/projects/modular-robots/'},
 {label:'03 / MEDICAL ROBOTICS CAPSTONE',title:'Acoustic sensing for intubation',summary:'What can sound tell us about an intubation tube’s contact with an airway?',contribution:'I proposed this capstone and led a four-person team. I built the actuator testbed, supports, and airway-phantom molds so we could study those signals under controlled motion.',result:'Getting useful recordings meant dealing with alignment, vibration, and fragile phantoms. That last problem still limited repeatability.',slug:'intubation',tags:'Actuator Testbed · Fixture Design · Acoustic Sensing'},
 {label:'04 / INDUSTRY',title:'Precision manufacturing equipment',summary:'Fixtures, printers, and post-processing hardware at Trio Labs.',contribution:'I took parts from CAD through fabrication and assembly, helped commission equipment, and tracked down problems as it came online. Some were mechanical; others involved wiring, sensors, or the process itself.',result:'',slug:'trio-labs',tags:'Equipment Design · Commissioning · Validation'},
];
---
<BaseLayout title={SITE.name}>
<div class="shell">
 <section class="hero">
  <p class="kicker">Mechanical design / Electromechanical systems</p>
  <h1>I design and build machines<br class="desktop-break"/> to solve real problems.</h1>
  <p class="intro">I’m Ben, a mechanical engineering M.S. student at Duke and a graduate researcher in the General Robotics Lab. My starting point is usually the hardware. From there, I work on how it moves, what it can sense, and how to get the whole setup working.</p>
  <div class="hero-footer"><span class="kicker">Duke M.S. · Graduating December 2026</span><div class="actions"><a class="primary" href="#work">Selected work ↓</a><a href="/about">About me</a><a href="https://www.linkedin.com/in/boyuan-ben-wang/">LinkedIn ↗</a></div></div>
 </section>
 <section id="work" aria-labelledby="selected-work">
  <div class="work-heading"><h2 id="selected-work" class="kicker">Selected work</h2><span class="kicker">2025—2026</span></div>
  <div class="project-list">{projects.map((project) => <article class="project-row">
   <div class="project-side"><span class="kicker">{project.label}</span>{project.image && <figure><a href={`/work/${project.slug}`} aria-label={`View ${project.title}`}><img src={project.image} alt={project.imageAlt || "Shadow robotic hand demonstrating projected shapes"} width="250" height="250" loading="lazy"/></a>{project.slug === "shadow-hand" && <figcaption>Project media: Duke General Robotics Lab</figcaption>}</figure>}</div>
   <div class="project-body"><h3><a href={`/work/${project.slug}`}>{project.title}</a></h3><p class="project-summary">{project.summary}</p><p>{project.contribution}</p>{project.result && <p class="project-result">{project.result}</p>}<div class="project-footer"><p class="project-tags">{project.tags}</p><a class="detail" href={project.gallery || `/work/${project.slug}`}>{project.gallery ? "View simulations ↗" : "View project ↗"}</a></div></div>
  </article>)}</div>
 </section>
 <section id="contact" class="contact-section"><h2>Get in touch</h2><div class="actions"><a href={`mailto:${SITE.email}`}>{SITE.email}</a><a href="https://www.linkedin.com/in/boyuan-ben-wang/">LinkedIn ↗</a></div></section>
</div>
</BaseLayout>
