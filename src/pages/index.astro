---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/site.config';
const projects = [
 {label:'01 / PUBLIC RESEARCH',title:'21-DoF robotic hand',summary:'Can a robot estimate the shape of its own hand from images?',contribution:'I designed the hand’s mechanisms and actuator packaging, built the URDF/PyBullet model, and integrated motor control and data logging. I also helped get the visual inference pipeline running on the physical setup.',result:'I traced a control-rate bottleneck to motor communication by testing joint groups separately, then reorganized the commands into batch updates.',slug:'shadow-hand',tags:'Mechanisms · Visual self-modeling · Control',image:'/shadow.gif'},
 {label:'02 / GRADUATION RESEARCH',title:'Computational modular robotics',summary:'Different tasks call for different robot shapes. I’m exploring how to build them from the same set of modules.',contribution:'I design the modules and their connections, and develop a search workflow that checks which assemblies can do the task. Reaching the target is only part of it—the motors and couplers also have to carry the load.',result:'I’m now working toward physical arm demonstrations.',slug:'modular-robotics',tags:'Mechanical design · Configuration search · MuJoCo'},
 {label:'03 / MEDICAL ROBOTICS CAPSTONE',title:'Acoustic sensing for intubation',summary:'What can sound tell us about an intubation tube’s contact with an airway?',contribution:'I proposed this capstone and led a four-person team. I built the actuator testbed, supports, and airway-phantom molds so we could study those signals under controlled motion.',result:'Getting useful recordings meant dealing with alignment, vibration, and fragile phantoms. That last problem still limited repeatability.',slug:'intubation',tags:'Acoustic sensing · Experimental hardware · Medical robotics'},
 {label:'04 / INDUSTRY',title:'Precision manufacturing equipment',summary:'Fixtures, printers, and post-processing hardware at Trio Labs.',contribution:'I took parts from CAD through fabrication and assembly, helped commission equipment, and tracked down problems as it came online. Some were mechanical; others involved wiring, sensors, or the process itself.',result:'',slug:'trio-labs',tags:'Mechanical design · Fabrication · Equipment bring-up'},
];
---
<BaseLayout title={SITE.name}>
<div class="shell">
 <section class="hero">
  <p class="kicker">Mechanical design / Electromechanical systems</p>
  <h1>I design and build machines<br class="desktop-break"/> to solve real problems.</h1>
  <p class="intro">I’m Ben, a mechanical engineering M.S. student at Duke and a graduate researcher in the General Robotics Lab. My starting point is usually the hardware. From there, I work on how it moves, what it can sense, and how to get the whole setup working.</p>
  <div class="hero-footer"><span class="kicker">Duke M.S. · Graduating December 2026</span><div class="actions"><a class="primary" href="#work">Selected work ↓</a><a href="/about">About me</a><a href="https://www.linkedin.com/in/boyuan-ben-wang/">LinkedIn ↗</a></div></div>
 </section>
 <section id="work" aria-labelledby="selected-work">
  <div class="work-heading"><h2 id="selected-work" class="kicker">Selected work</h2><span class="kicker">2025—2026</span></div>
  <div class="project-list">{projects.map((project) => <article class="project-row">
   <div class="project-side"><span class="kicker">{project.label}</span>{project.image && <figure><a href={`/work/${project.slug}`} aria-label={`View ${project.title}`}><img src={project.image} alt="Shadow robotic hand demonstrating projected shapes" width="250" height="250" loading="lazy"/></a><figcaption>Project media: Duke General Robotics Lab</figcaption></figure>}</div>
   <div class="project-body"><h3><a href={`/work/${project.slug}`}>{project.title}</a></h3><p class="project-summary">{project.summary}</p><p>{project.contribution}</p>{project.result && <p class="project-result">{project.result}</p>}<div class="project-footer"><p class="project-tags">{project.tags}</p><a class="detail" href={`/work/${project.slug}`}>View project ↗</a></div></div>
  </article>)}</div>
 </section>
 <aside class="band"><h2 class="kicker">Additional research</h2><p>I’m also working on hardware and integration for a robotics automation project that isn’t public yet.</p></aside>
 <section id="contact" class="contact-section"><h2>Get in touch</h2><div class="actions"><a href={`mailto:${SITE.email}`}>{SITE.email}</a><a href="https://www.linkedin.com/in/boyuan-ben-wang/">LinkedIn ↗</a></div></section>
</div>
</BaseLayout>
